{
  "name": "sprint-mufrodat",
  "version": "0.1.0",
  "description": "Game Sprint 60 Detik — lomba mufrodat bahasa Arab multipemain (prototipe)",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "speech:setup": "bash scripts/setup-qiroah-speech.sh",
    "speech": "bash scripts/start-qiroah-speech.sh",
    "test": "node --test --test-concurrency=1 test/learning.test.js test/qiroah.test.js test/qiroah-reading.test.js test/quran.test.js",
    "test:legacy": "node test/simulate.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  }
}
